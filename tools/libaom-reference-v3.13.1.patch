+static void avifdec_hash_mode(DecoderCodingBlock *dcb, int mi_row, int mi_col,
+                              int width, int height) {
+  MACROBLOCKD *const xd = &dcb->xd;
+  MB_MODE_INFO *const mbmi = dcb->xd.mi[0];
+  AvifdecReferenceTrace *const trace = dcb->avifdec_reference_trace;
+  if (trace == NULL) return;
+  if (is_inter_block(mbmi)) {
+    const int ref_type = av1_ref_frame_type(mbmi->ref_frame);
+    const int count = dcb->ref_mv_count[ref_type];
+    ++trace->inter_block_count;
+    if (has_second_ref(mbmi)) ++trace->compound_block_count;
+    if (is_interintra_pred(mbmi)) ++trace->interintra_block_count;
+    if (mbmi->motion_mode == OBMC_CAUSAL) ++trace->obmc_block_count;
+    if (mbmi->motion_mode == WARPED_CAUSAL) ++trace->local_warp_block_count;
+    if (is_global_mv_block(
+            mbmi, xd->global_motion[mbmi->ref_frame[0]].wmtype)) {
+      ++trace->global_warp_block_count;
+    }
+    if (mbmi->skip_mode) ++trace->skip_mode_block_count;
+    trace->inter_mode_mask |= UINT64_C(1) << mbmi->mode;
+    trace->interpolation_filter_mask |=
+        UINT64_C(1) << av1_extract_interp_filter(mbmi->interp_filters, 0);
+    trace->interpolation_filter_mask |=
+        UINT64_C(1) << av1_extract_interp_filter(mbmi->interp_filters, 1);
+    trace->motion_mode_mask |= UINT64_C(1) << mbmi->motion_mode;
+    fprintf(stderr,
+            "avifdec_inter_block=%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
+            mi_row, mi_col, width, height, mbmi->mode, mbmi->motion_mode,
+            mbmi->num_proj_ref, mbmi->mv[0].as_mv.row,
+            mbmi->mv[0].as_mv.col, mbmi->ref_mv_idx, count,
+            count > 0 ? xd->ref_mv_stack[ref_type][0].this_mv.as_mv.row : 0,
+            count > 0 ? xd->ref_mv_stack[ref_type][0].this_mv.as_mv.col : 0,
+            mbmi->ref_frame[0], mbmi->ref_frame[1]);
+    avifdec_reference_hash(&trace->inter_mode_checksum, mi_row);
+    avifdec_reference_hash(&trace->inter_mode_checksum, mi_col);
+    avifdec_reference_hash(&trace->inter_mode_checksum, mbmi->ref_frame[0]);
+    avifdec_reference_hash(&trace->inter_mode_checksum,
+                           has_second_ref(mbmi) ? mbmi->ref_frame[1] : 0);
+    avifdec_reference_hash(&trace->inter_mode_checksum, mbmi->mode);
+    avifdec_reference_hash(&trace->inter_mode_checksum, mbmi->ref_mv_idx);
+    avifdec_reference_hash(&trace->mv_stack_checksum, count);
+    for (int index = 0; index < count; ++index) {
+      avifdec_reference_hash(
+          &trace->mv_stack_checksum,
+          (uint32_t)xd->ref_mv_stack[ref_type][index].this_mv.as_mv.row);
+      avifdec_reference_hash(
+          &trace->mv_stack_checksum,
+          (uint32_t)xd->ref_mv_stack[ref_type][index].this_mv.as_mv.col);
+      avifdec_reference_hash(
+          &trace->mv_stack_checksum,
+          (uint32_t)xd->ref_mv_stack[ref_type][index].comp_mv.as_mv.row);
+      avifdec_reference_hash(
+          &trace->mv_stack_checksum,
+          (uint32_t)xd->ref_mv_stack[ref_type][index].comp_mv.as_mv.col);
+      avifdec_reference_hash(&trace->mv_stack_checksum,
+                             xd->weight[ref_type][index]);
+    }
+    avifdec_reference_hash(&trace->mv_checksum,
+                           (uint32_t)mbmi->mv[0].as_mv.row);
+    avifdec_reference_hash(&trace->mv_checksum,
+                           (uint32_t)mbmi->mv[0].as_mv.col);
+    avifdec_reference_hash(&trace->mv_checksum,
+                           (uint32_t)mbmi->mv[1].as_mv.row);
+    avifdec_reference_hash(&trace->mv_checksum,
+                           (uint32_t)mbmi->mv[1].as_mv.col);
+  }
+  if (is_intrabc_block(mbmi)) {
+    ++trace->intrabc_block_count;
+    fprintf(stderr, "avifdec_intrabc_block=%d,%d,%d,%d,%d,%d\n",
+            mi_row, mi_col, width, height, mbmi->mv[0].as_mv.row,
+            mbmi->mv[0].as_mv.col);
+  }
+  uint64_t *const checksum = &trace->mode_checksum;
+  const int angle_delta_y =
+      mbmi->mode >= V_PRED && mbmi->mode <= D67_PRED
+          ? mbmi->angle_delta[PLANE_TYPE_Y]
+          : 0;
+  const int angle_delta_uv =
+      mbmi->uv_mode >= UV_V_PRED && mbmi->uv_mode <= UV_D67_PRED
+          ? mbmi->angle_delta[PLANE_TYPE_UV]
+          : 0;
+  const int use_filter_intra =
+      mbmi->filter_intra_mode_info.use_filter_intra;
+  const int cfl_alpha_u =
+      mbmi->uv_mode == UV_CFL_PRED
+          ? avifdec_cfl_alpha(mbmi->cfl_alpha_idx, mbmi->cfl_alpha_signs, 0)
+          : 0;
+  const int cfl_alpha_v =
+      mbmi->uv_mode == UV_CFL_PRED
+          ? avifdec_cfl_alpha(mbmi->cfl_alpha_idx, mbmi->cfl_alpha_signs, 1)
+          : 0;
+  ++trace->block_count;
+  if ((mbmi->mode >= V_PRED && mbmi->mode <= D67_PRED) ||
+      (mbmi->uv_mode >= UV_V_PRED && mbmi->uv_mode <= UV_D67_PRED)) {
+    ++trace->directional_block_count;
+  }
+  if (mbmi->palette_mode_info.palette_size[0] != 0 ||
+      mbmi->palette_mode_info.palette_size[1] != 0) {
+    ++trace->palette_block_count;
+  }
+  if (mbmi->uv_mode == UV_CFL_PRED) ++trace->cfl_block_count;
+  if (use_filter_intra) ++trace->filter_intra_block_count;
+  avifdec_reference_hash(checksum, mi_row);
+  avifdec_reference_hash(checksum, mi_col);
+  avifdec_reference_hash(checksum, width);
+  avifdec_reference_hash(checksum, height);
+  avifdec_reference_hash(checksum, mbmi->mode);
+  avifdec_reference_hash(checksum, mbmi->uv_mode);
+  avifdec_reference_hash(checksum, (uint8_t)angle_delta_y);
+  avifdec_reference_hash(checksum, (uint8_t)angle_delta_uv);
+  avifdec_reference_hash(checksum, use_filter_intra);
+  avifdec_reference_hash(
+      checksum, use_filter_intra
+                    ? mbmi->filter_intra_mode_info.filter_intra_mode
+                    : 0);
+  const PALETTE_MODE_INFO *const palette = &mbmi->palette_mode_info;
+  avifdec_reference_hash(checksum, palette->palette_size[0]);
+  avifdec_reference_hash(checksum, palette->palette_size[1]);
+  avifdec_reference_hash(checksum, (uint8_t)cfl_alpha_u);
+  avifdec_reference_hash(checksum, (uint8_t)cfl_alpha_v);
+  for (int index = 0; index < palette->palette_size[0]; ++index) {
+    avifdec_reference_hash(checksum, palette->palette_colors[index]);
+  }
+  for (int index = 0; index < palette->palette_size[1]; ++index) {
+    avifdec_reference_hash(
+        checksum, palette->palette_colors[PALETTE_MAX_SIZE + index]);
+    avifdec_reference_hash(
+        checksum, palette->palette_colors[2 * PALETTE_MAX_SIZE + index]);
+  }
+}
+
+static void avifdec_hash_predictor(const AV1_COMMON *cm,
+                                   DecoderCodingBlock *dcb, int plane,
+                                   int row, int col, TX_SIZE tx_size) {
+  MACROBLOCKD *const xd = &dcb->xd;
+  struct macroblockd_plane *const pd = &xd->plane[plane];
+  AvifdecReferenceTrace *const trace = dcb->avifdec_reference_trace;
+  if (trace == NULL) return;
+  uint64_t *const checksum = &trace->predictor_checksum;
+  const int mi_row = -xd->mb_to_top_edge >> (3 + MI_SIZE_LOG2);
+  const int mi_col = -xd->mb_to_left_edge >> (3 + MI_SIZE_LOG2);
+  const int x4 = (mi_col >> pd->subsampling_x) + col;
+  const int y4 = (mi_row >> pd->subsampling_y) + row;
+  const int max_x4 =
+      (cm->mi_params.mi_cols + pd->subsampling_x) >> pd->subsampling_x;
+  const int max_y4 =
+      (cm->mi_params.mi_rows + pd->subsampling_y) >> pd->subsampling_y;
+  const int width4 = AOMMIN(tx_size_wide_unit[tx_size], max_x4 - x4);
+  const int height4 = AOMMIN(tx_size_high_unit[tx_size], max_y4 - y4);
+  const int width = width4 << MI_SIZE_LOG2;
+  const int height = height4 << MI_SIZE_LOG2;
+  const int offset = (row * pd->dst.stride + col) << MI_SIZE_LOG2;
+  avifdec_reference_hash(checksum, plane);
+  avifdec_reference_hash(checksum, x4);
+  avifdec_reference_hash(checksum, y4);
+  avifdec_reference_hash(checksum, tx_size);
+  if (cm->seq_params->use_highbitdepth) {
+    const uint16_t *const predictor = CONVERT_TO_SHORTPTR(pd->dst.buf) + offset;
+    for (int y = 0; y < height; ++y) {
+      for (int x = 0; x < width; ++x) {
+        avifdec_reference_hash(checksum,
+                               predictor[y * pd->dst.stride + x]);
+      }
+    }
+  } else {
+    const uint8_t *const predictor = pd->dst.buf + offset;
+    for (int y = 0; y < height; ++y) {
+      for (int x = 0; x < width; ++x) {
+        avifdec_reference_hash(checksum,
+                               predictor[y * pd->dst.stride + x]);
+      }
+    }
+  }
+}
