+static void avifdec_reference_hash(uint64_t *checksum, uint64_t value) {
+  for (int byte = 0; byte < 8; ++byte) {
+    *checksum ^= (uint8_t)(value >> (byte * 8));
+    *checksum *= AVIFDEC_FNV_PRIME;
+  }
+}
+
+static uint64_t avifdec_stage_checksum(const AV1_COMMON *cm) {
+  const YV12_BUFFER_CONFIG *const frame = &cm->cur_frame->buf;
+  uint64_t checksum = AVIFDEC_FNV_OFFSET;
+  const int high_bitdepth = cm->seq_params->use_highbitdepth;
+  for (int plane = 0; plane < av1_num_planes(cm); ++plane) {
+    const int is_uv = plane > 0;
+    const int width = frame->crop_widths[is_uv];
+    const int height = frame->crop_heights[is_uv];
+    const int stride = frame->strides[is_uv];
+    uint64_t plane_checksum = AVIFDEC_FNV_OFFSET;
+    plane_checksum ^= (uint8_t)plane;
+    plane_checksum *= AVIFDEC_FNV_PRIME;
+    for (int row = 0; row < height; ++row) {
+      for (int column = 0; column < width; ++column) {
+        const uint16_t sample = high_bitdepth
+            ? CONVERT_TO_SHORTPTR(frame->buffers[plane])[row * stride + column]
+            : frame->buffers[plane][row * stride + column];
+        plane_checksum ^= (uint8_t)sample;
+        plane_checksum *= AVIFDEC_FNV_PRIME;
+        plane_checksum ^= (uint8_t)(sample >> 8);
+        plane_checksum *= AVIFDEC_FNV_PRIME;
+      }
+    }
+    avifdec_reference_hash(&checksum, plane_checksum);
+  }
+  return checksum;
+}
+
+static void avifdec_print_stage_plane_checksums(const AV1_COMMON *cm,
+                                                 const char *stage) {
+  const YV12_BUFFER_CONFIG *const frame = &cm->cur_frame->buf;
+  const int high_bitdepth = cm->seq_params->use_highbitdepth;
+  for (int plane = 0; plane < av1_num_planes(cm); ++plane) {
+    const int is_uv = plane > 0;
+    const int width = frame->crop_widths[is_uv];
+    const int height = frame->crop_heights[is_uv];
+    const int stride = frame->strides[is_uv];
+    uint64_t checksum = AVIFDEC_FNV_OFFSET;
+    checksum ^= (uint8_t)plane;
+    checksum *= AVIFDEC_FNV_PRIME;
+    for (int row = 0; row < height; ++row) {
+      for (int column = 0; column < width; ++column) {
+        const uint16_t sample = high_bitdepth
+            ? CONVERT_TO_SHORTPTR(frame->buffers[plane])[row * stride + column]
+            : frame->buffers[plane][row * stride + column];
+        checksum ^= (uint8_t)sample;
+        checksum *= AVIFDEC_FNV_PRIME;
+        checksum ^= (uint8_t)(sample >> 8);
+        checksum *= AVIFDEC_FNV_PRIME;
+      }
+    }
+    fprintf(stderr, "avifdec_%s_plane_checksum=0x%016llx\n", stage,
+            (unsigned long long)checksum);
+  }
+}
