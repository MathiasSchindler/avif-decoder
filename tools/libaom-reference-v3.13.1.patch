+static void avifdec_hash_reference_state(AV1Decoder *pbi) {
+  AV1_COMMON *const cm = &pbi->common;
+  if (pbi->avifdec_reference_frame_count == 0) {
+    pbi->avifdec_reference_state_checksum = AVIFDEC_FNV_OFFSET;
+  }
+  ++pbi->avifdec_reference_frame_count;
+  avifdec_state_hash(&pbi->avifdec_reference_state_checksum,
+                     pbi->avifdec_reference_frame_count);
+  avifdec_state_hash(&pbi->avifdec_reference_state_checksum,
+                     cm->show_existing_frame);
+  avifdec_state_hash(&pbi->avifdec_reference_state_checksum,
+                     cm->current_frame.refresh_frame_flags);
+  for (int index = 0; index < REF_FRAMES; ++index) {
+    const RefCntBuffer *const slot = cm->ref_frame_map[index];
+    avifdec_state_hash(&pbi->avifdec_reference_state_checksum, index);
+    avifdec_state_hash(&pbi->avifdec_reference_state_checksum, slot != NULL);
+    avifdec_state_hash(&pbi->avifdec_reference_state_checksum,
+                       cm->ref_frame_id[index]);
+    avifdec_state_hash(&pbi->avifdec_reference_state_checksum,
+                       slot != NULL ? slot->order_hint : 0);
+    avifdec_state_hash(&pbi->avifdec_reference_state_checksum,
+                       slot != NULL ? slot->buf.crop_widths[0] : 0);
+    avifdec_state_hash(&pbi->avifdec_reference_state_checksum,
+                       slot != NULL ? slot->buf.crop_heights[0] : 0);
+    avifdec_state_hash(&pbi->avifdec_reference_state_checksum,
+                       slot != NULL ? slot->frame_type : 0);
+    avifdec_state_hash(&pbi->avifdec_reference_state_checksum,
+                       slot != NULL ? slot->showable_frame : 0);
+  }
+  fprintf(stderr, "avifdec_reference_state_checksum=0x%016llx\n",
+          (unsigned long long)pbi->avifdec_reference_state_checksum);
+  fprintf(stderr, "avifdec_reference_frames=%llu\n",
+          (unsigned long long)pbi->avifdec_reference_frame_count);
+}
+#endif
