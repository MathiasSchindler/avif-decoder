+static void avifdec_hash_quantized(const AV1_COMMON *cm,
+                                   DecoderCodingBlock *dcb, int plane,
+                                   int row, int col, TX_SIZE tx_size,
+                                   const tran_low_t *quantized,
+                                   const tran_low_t *dequantized) {
+  MACROBLOCKD *const xd = &dcb->xd;
+  struct macroblockd_plane *const pd = &xd->plane[plane];
+  AvifdecReferenceTrace *const trace = dcb->avifdec_reference_trace;
+  if (trace == NULL) return;
+  uint64_t *const checksum = &trace->quantized_checksum;
+  const int mi_row = -xd->mb_to_top_edge >> (3 + MI_SIZE_LOG2);
+  const int mi_col = -xd->mb_to_left_edge >> (3 + MI_SIZE_LOG2);
+  const int x4 = (mi_col >> pd->subsampling_x) + col;
+  const int y4 = (mi_row >> pd->subsampling_y) + row;
+  const TX_TYPE tx_type = av1_get_tx_type(
+      xd, get_plane_type(plane), row, col, tx_size,
+      cm->features.reduced_tx_set_used);
+  const int packed_width = AOMMIN(tx_size_wide[tx_size], 32);
+  const int packed_height = AOMMIN(tx_size_high[tx_size], 32);
+  int nonzero = 0;
+  avifdec_reference_hash(checksum, plane);
+  avifdec_reference_hash(checksum, x4);
+  avifdec_reference_hash(checksum, y4);
+  avifdec_reference_hash(checksum, tx_type);
+  for (int y = 0; y < packed_height; ++y) {
+    for (int x = 0; x < packed_width; ++x) {
+      const int index = x * packed_height + y;
+      avifdec_reference_hash(checksum, (uint32_t)quantized[index]);
+      avifdec_reference_hash(&trace->dequantized_checksum,
+                             (uint32_t)dequantized[index]);
+      if (quantized[index] != 0) nonzero = 1;
+    }
+  }
+  ++trace->transform_count;
+  if (nonzero) ++trace->nonzero_transform_count;
+}
+#endif
