+static int avifdec_cfl_alpha(uint8_t alpha_idx, int8_t joint_sign,
+                             int plane) {
+  const int sign = plane == 0 ? CFL_SIGN_U(joint_sign)
+                              : CFL_SIGN_V(joint_sign);
+  if (sign == CFL_SIGN_ZERO) return 0;
+  const int magnitude = (plane == 0 ? CFL_IDX_U(alpha_idx)
+                                    : CFL_IDX_V(alpha_idx)) + 1;
+  return sign == CFL_SIGN_POS ? magnitude : -magnitude;
+}
